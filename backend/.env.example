# OpenGem / OpenAI-compatible provider (local OpenGem default)
AI_PROVIDER=opengem
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:3050/v1
OPENAI_COMPATIBLE_API_KEY=
AI_MODELS=gpt-4o,gemini-3.5-flash,gemini-2.5-flash

# Google Gemini fallback/provider: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# "base" = Systran/faster-whisper-base (downloaded once, ~145 MB, then cached).
# Or an absolute path to a model folder exported with `whisper-local --export-model`.
WHISPER_MODEL=base
# Force a language (e.g. en, hi). Empty = auto-detect.
WHISPER_LANGUAGE=

FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
